# ==========================================
# IBVAP Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ==========================================

# Application Environment ('development' or 'production')
ENVIRONMENT=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ibvap

# JWT secret - generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MANDATORY in production environments: app will halt if left as default.
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# Storage directories
UPLOAD_DIR=./uploads
SNAPSHOT_DIR=./snapshots
SAMPLE_VIDEO_DIR=./sample_videos

# Detection defaults
DETECTION_CONFIDENCE_THRESHOLD=0.5
NIGHT_START=18:30
NIGHT_END=06:00

# Threat scoring weights
WEIGHT_UNKNOWN_PERSON=30
WEIGHT_NIGHT_MOVEMENT=15
WEIGHT_FENCE_CROSSING=30
WEIGHT_VEHICLE_NEARBY=10
WEIGHT_HIGH_RISK_ZONE=15

# Visibility thresholds
VISIBILITY_CLEAR_THRESHOLD=70
VISIBILITY_MODERATE_THRESHOLD=40

# Alerts
ALERT_COOLDOWN_SECONDS=20

# Optional - not required for core functionality
LLM_API_KEY=
